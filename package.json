{
  "name": "finanzarchiv2",
  "private": true,
  "type": "module",
  "description": "Finanzarchiv 2.0, die Oberfläche",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings src scripts",
    "test": "vitest run",
    "tauri": "tauri",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib write_bindings -- --ignored",
    "corpus": "cargo run --manifest-path src-tauri/Cargo.toml --example corpus -- --seed 2026 --out fixtures/synthetic",
    "measure": "cargo run --release --manifest-path src-tauri/Cargo.toml --example measure -- --corpus fixtures/synthetic",
    "check:views": "node scripts/check-views.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.95.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
